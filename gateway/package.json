{
  "name": "gateway",
  "version": "0.1.0",
  "description": "Headlamp plugin for the Kubernetes Gateway API: overview, topology, guided forms, wizards and relationship-aware detail views",
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "kubernetes-ui",
    "gateway-api",
    "gateway",
    "httproute",
    "envoy-gateway"
  ],
  "homepage": "https://github.com/batuhancikrikci/headlamp-plugins/tree/main/gateway#readme",
  "bugs": {
    "url": "https://github.com/batuhancikrikci/headlamp-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batuhancikrikci/headlamp-plugins.git",
    "directory": "gateway"
  },
  "license": "Apache-2.0",
  "author": "Batuhan CIKRIKCI",
  "origin": "headlamp-plugins",
  "engines": {
    "node": ">=20.11.1",
    "npm": ">=10.0.0"
  },
  "headlamp": {
    "minVersion": "0.45.0",
    "extraDist": {
      "LICENSE": "LICENSE",
      "NOTICE": "NOTICE"
    }
  },
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "start": "npm run icons && headlamp-plugin start",
    "build": "npm run icons && headlamp-plugin build",
    "package": "npm run build && headlamp-plugin package",
    "deploy": "node scripts/deploy.mjs",
    "deploy:fast": "node scripts/deploy.mjs --skip-checks",
    "check": "npm run tsc && npm run lint && npm test",
    "tsc": "headlamp-plugin tsc",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "format": "headlamp-plugin format",
    "test": "headlamp-plugin test",
    "storybook": "npm run icons && headlamp-plugin storybook",
    "storybook-build": "npm run icons && headlamp-plugin storybook-build"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@kinvolk/headlamp-plugin": "^0.14.0",
    "@types/js-yaml": "^4.0.9"
  },
  "overrides": {
    "typescript": "5.6.2"
  },
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  }
}
